# Copy to .env for local development. Never commit .env.
# In staging and production these come from the host's secret store.

# The apps' API connects as a login granted stitchflow_api (see README "Database").
DATABASE_URL=postgres://api_login:change-me@localhost:5432/stitchflow

# The web admin panel's API: a login granted stitchflow_platform.
# Leave unset to use DATABASE_URL (only if that login is granted both roles).
PLATFORM_DATABASE_URL=postgres://console_login:change-me@localhost:5432/stitchflow

# Migrations run as the schema owner (row-level security does not restrict it).
MIGRATION_DATABASE_URL=postgres://stitchflow_owner:owner-dev@localhost:5432/stitchflow

# Signs access tokens and photo links. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000
HOST=0.0.0.0
# Uploaded photos (local disk until object storage is decided).
FILES_DIR=var/files
# Run the daily bin purge and session cleanup inside the API process.
RUN_JOBS=true
LOG_LEVEL=info
# true behind a load balancer / reverse proxy, so client IPs and https are seen.
TRUST_PROXY=false
