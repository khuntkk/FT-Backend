# Copy to .env for development. Never commit .env. README "First run" says
# where each value comes from in the Supabase dashboard.

# --- Database (Supabase Postgres) -------------------------------------------
# Migrations run as the schema owner: Supabase's `postgres`, through the
# session pooler.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# The apps' API: login api_login (granted stitchflow_api), transaction pooler.
DATABASE_URL=postgresql://api_login.<project-ref>:<api-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# The web admin panel's API: login console_login (granted stitchflow_platform).
PLATFORM_DATABASE_URL=postgresql://console_login.<project-ref>:<console-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# TLS: verify the server against Supabase's CA certificate (Database settings
# → SSL → Download certificate). `require` encrypts without checking; `off` is
# plain (the default only for localhost).
DATABASE_SSL=verify
DATABASE_CA_FILE=certs/supabase-ca.crt

# --- Photos (Supabase Storage) ----------------------------------------------
# Unset SUPABASE_URL to keep photos on local disk (FILES_DIR) instead.
SUPABASE_URL=https://<project-ref>.supabase.co
# A secret key (sb_secret_...) or the legacy service_role key. Server-side only.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=stitchflow-photos
FILES_DIR=var/files

# --- API --------------------------------------------------------------------
# Signs access tokens and local photo links. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000
HOST=0.0.0.0
# Run the daily bin purge and session cleanup inside the API process.
RUN_JOBS=true
LOG_LEVEL=info
# true behind a load balancer / reverse proxy, so client IPs and https are seen.
TRUST_PROXY=false
# Browser origins allowed to call the API: the web admin panel when it is not
# served behind the API (comma-separated). Dev uses the panel's Vite proxy instead.
CORS_ORIGINS=
